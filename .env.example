# OPTIONAL. Docker works without this file.
# Copy to .env (next to docker-compose.yml) only if you need to change a default.

# Host ports. If you change BACKEND_PORT, also update VITE_API_URL in frontend/.env.
BACKEND_PORT=8000
FORWARD_DB_PORT=3307
PHPMYADMIN_PORT=8080
MAILPIT_PORT=8025

# Linux hosts only: run `id -u` and `id -g` and put the values here so files
# created inside the backend container (logs, migrations, etc.) belong to you.
HOST_UID=1000
HOST_GID=1000

# Windows/macOS bind mounts don't forward file-change events into containers.
# Polling keeps Vite hot reload working. Set to false on native Linux to save CPU.
VITE_USE_POLLING=true
