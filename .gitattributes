# Normalise line endings to LF for everything that runs inside Linux containers.
# Without this, Windows checkouts turn shell scripts into CRLF and containers fail with "/bin/sh^M: not found".
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
